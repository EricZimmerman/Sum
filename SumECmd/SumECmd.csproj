<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AssemblyTitle>SumECmd</AssemblyTitle>
    <Company>Eric R. Zimmerman</Company>
    <Product>SumECmd</Product>
    <Description>Process Sum data from Windows Server</Description>
    <Copyright>Eric R. Zimmerman 2027</Copyright>
    <LangVersion>10</LangVersion>
    <Version>2026.10.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>Calendar52Day.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
    <ProjectReference Include="..\SumData\SumData.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Calendar52Day.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Exceptionless" Version="6.2.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="ServiceStack.Text" Version="10.4.0" />
  </ItemGroup>
</Project>
